﻿# Cloudflare Pages headers config.
# Mirrors the headers previously defined in netlify.toml so behaviour is identical
# on either host. See https://developers.cloudflare.com/pages/configuration/headers/.

# Long-cache static assets (same-origin only; HTML stays no-cache)
/assets/pwa.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so deploys take effect immediately
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Pretty routes served by Pages should be treated like HTML too.
/
  Cache-Control: no-cache, no-store, must-revalidate
/about
  Cache-Control: no-cache, no-store, must-revalidate
/contact
  Cache-Control: no-cache, no-store, must-revalidate
/privacy
  Cache-Control: no-cache, no-store, must-revalidate
/terms
  Cache-Control: no-cache, no-store, must-revalidate
/refund
  Cache-Control: no-cache, no-store, must-revalidate
/shipping
  Cache-Control: no-cache, no-store, must-revalidate
/passport-photo
  Cache-Control: no-cache, no-store, must-revalidate
/id-print
  Cache-Control: no-cache, no-store, must-revalidate

/forms
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker must always revalidate â€” otherwise a stale SW keeps serving
# stale precache entries long after the next deploy.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Security headers (apply to every response)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
