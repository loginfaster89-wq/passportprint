# Cloudflare Pages headers config.
# Mirrors the headers previously defined in netlify.toml so behaviour is identical
# on either host. See https://developers.cloudflare.com/pages/configuration/headers/.

# App shell assets must revalidate on every visit. These files carry layout,
# auth, pricing, and service-worker boot logic; stale copies were forcing users
# to hard refresh several times before the new UI appeared.
/assets/pwa.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*.css
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/assets/forms/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Long-cache hashed/static media assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so deploys take effect immediately
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Pretty routes served by Pages should be treated like HTML too.
/
  Cache-Control: no-cache, no-store, must-revalidate
/about
  Cache-Control: no-cache, no-store, must-revalidate
/contact
  Cache-Control: no-cache, no-store, must-revalidate
/privacy
  Cache-Control: no-cache, no-store, must-revalidate
/terms
  Cache-Control: no-cache, no-store, must-revalidate
/refund
  Cache-Control: no-cache, no-store, must-revalidate
/shipping
  Cache-Control: no-cache, no-store, must-revalidate
/passport-photo
  Cache-Control: no-cache, no-store, must-revalidate
/id-print
  Cache-Control: no-cache, no-store, must-revalidate

/forms
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker must always revalidate - otherwise a stale SW keeps serving
# stale precache entries long after the next deploy.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Security headers (apply to every response)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://checkout.razorpay.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; connect-src 'self' https://passportprint-studio.onrender.com https://accounts.google.com https://checkout.razorpay.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://huggingface.co https://*.hf.co; frame-src https://accounts.google.com https://checkout.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'


